package templates

import (
	"strings"

	"github.com/ntub/domjudge-tool/internal/model"
)

// ContestSelectFragment renders the contest picker dropped into #contest-fragment.
// When followProblems is true, changing or loading the select also patches the
// problems-problem_ids-fragment (only used on the Download Submissions screen).
templ ContestSelectFragment(contests []model.Contest, defaultID *string, required bool, followProblems bool) {
	<div id="contest-fragment">
		<div class="form-control">
			<label class="label" for="frag_contest_id">
				<span class="label-text font-medium">Contest</span>
			</label>
			<select
				id="frag_contest_id"
				name="contest_id"
				class="select select-bordered w-full"
				data-bind:contest-id
				if followProblems {
					data-on:change="@get('/api/fragment/problems?field=problem_ids')"
					data-on:load="@get('/api/fragment/problems?field=problem_ids')"
				}
				if required { required }
			>
				<option value="">— select a contest —</option>
				for _, c := range contests {
					if defaultID != nil && *defaultID == c.ID {
						<option value={ c.ID } selected>{ c.Name } ({ c.ShortName })</option>
					} else {
						<option value={ c.ID }>{ c.Name } ({ c.ShortName })</option>
					}
				}
			</select>
		</div>
	</div>
}

// ContestInputFragment renders a plain text input inside #contest-fragment.
// Used as initial state and as fallback when the API is unavailable.
// errMsg, when non-empty, shows a warning beside the field.
templ ContestInputFragment(placeholder, helpText, errMsg string, required bool) {
	<div id="contest-fragment">
		<div class="form-control">
			<label class="label" for="frag_contest_id">
				<span class="label-text font-medium">Contest ID</span>
			</label>
			<input
				id="frag_contest_id"
				type="text"
				name="contest_id"
				placeholder={ placeholder }
				class="input input-bordered w-full"
				if required { required }
			/>
			<label class="label">
				if errMsg != "" {
					<span class="label-text-alt text-warning">{ errMsg } Enter the contest ID manually.</span>
				} else {
					<span class="label-text-alt">{ helpText }</span>
				}
			</label>
		</div>
	</div>
}

// UsernameSelectFragment renders the username picker dropped into #username-fragment
// by an SSE response when the profile select changes.
templ UsernameSelectFragment(users []model.User, required bool) {
	<div id="username-fragment">
		<div class="form-control">
			<label class="label" for="frag_username">
				<span class="label-text font-medium">Username</span>
			</label>
			<select id="frag_username" name="username" class="select select-bordered w-full" if required { required }>
				<option value="">— select a user —</option>
				for _, u := range users {
					<option value={ u.Username }>{ u.Name } ({ u.Username })</option>
				}
			</select>
		</div>
	</div>
}

// UsernameInputFragment renders a plain text input inside #username-fragment.
// Used as initial state and as fallback when the API is unavailable.
// errMsg, when non-empty, shows a warning beside the field.
templ UsernameInputFragment(placeholder, helpText, errMsg string, required bool) {
	<div id="username-fragment">
		<div class="form-control">
			<label class="label" for="frag_username">
				<span class="label-text font-medium">Username</span>
			</label>
			<input
				id="frag_username"
				type="text"
				name="username"
				placeholder={ placeholder }
				class="input input-bordered w-full"
				if required { required }
				autocomplete="off"
			/>
			<label class="label">
				if errMsg != "" {
					<span class="label-text-alt text-warning">{ errMsg } Enter the username manually.</span>
				} else {
					<span class="label-text-alt">{ helpText }</span>
				}
			</label>
		</div>
	</div>
}

// ProblemsTextInputFragment renders a text input fallback for problems.
templ ProblemsTextInputFragment(fieldName, labelText, placeholder, helpText string) {
	<div id={ "problems-" + fieldName + "-fragment" }>
		<div class="form-control">
			<label class="label" for={ "frag_" + fieldName }>
				<span class="label-text font-medium">{ labelText }</span>
			</label>
			<input
				id={ "frag_" + fieldName }
				type="text"
				name={ fieldName }
				placeholder={ placeholder }
				class="input input-bordered w-full"
			/>
			if helpText != "" {
				<label class="label">
					<span class={ "label-text-alt", templ.KV("text-warning", strings.HasPrefix(helpText, "Could not") || strings.HasPrefix(helpText, "Failed") || strings.Contains(helpText, "error") || strings.Contains(helpText, "failed")) }>{ helpText }</span>
				</label>
			}
		</div>
	</div>
}

// SelectOption represents an option for TagMultiSelect.
type SelectOption struct {
	Value string
	Label string
}

// triggerSyncTags is a templ script helper that invokes syncTags.
script triggerSyncTags(fragmentID string) {
	window.syncTags(fragmentID);
}

// TagMultiSelect renders a multi-select dropdown with tag list.
templ TagMultiSelect(fragmentID, fieldName, labelText string, items []SelectOption, helpText string) {
	<div id={ fragmentID }>
		<div class="form-control">
			<label class="label">
				<span class="label-text font-medium">{ labelText }</span>
			</label>
			<select
				id={ fragmentID + "-options" }
				class="select select-bordered w-full"
				onchange={ triggerSyncTags(fragmentID) }
			>
				<option value="">— select an option —</option>
				for _, item := range items {
					<option value={ item.Value }>{ item.Label }</option>
				}
			</select>
			<div id={ fragmentID + "-tags" } class="flex flex-wrap gap-2 mt-2"></div>
			<input
				type="hidden"
				name={ fieldName }
				id={ fragmentID + "-hidden" }
				value=""
			/>
			if helpText != "" {
				<label class="label">
					<span class="label-text-alt">{ helpText }</span>
				</label>
			}
		</div>
		@tagSelectScriptOnce()
	</div>
}

// tagSelectScriptOnce outputs the helper script.
templ tagSelectScriptOnce() {
	<script>
		if (typeof window.syncTags === 'undefined') {
			window.syncTags = function(fragmentID) {
				const select = document.getElementById(fragmentID + '-options');
				if (!select) return;
				const val = select.value;
				if (!val) return;
				
				const hidden = document.getElementById(fragmentID + '-hidden');
				if (!hidden) return;
				
				let values = hidden.value ? hidden.value.split(',').map(s => s.trim()).filter(Boolean) : [];
				if (!values.includes(val)) {
					values.push(val);
					hidden.value = values.join(',');
					hidden.dispatchEvent(new Event('input', { bubbles: true }));
					hidden.dispatchEvent(new Event('change', { bubbles: true }));
				}
				select.value = '';
				window.renderTags(fragmentID, values, select);
			};
		}
		if (typeof window.deselectTag === 'undefined') {
			window.deselectTag = function(fragmentID, val) {
				const hidden = document.getElementById(fragmentID + '-hidden');
				if (!hidden) return;
				
				let values = hidden.value ? hidden.value.split(',').map(s => s.trim()).filter(Boolean) : [];
				values = values.filter(v => v !== val);
				hidden.value = values.join(',');
				hidden.dispatchEvent(new Event('input', { bubbles: true }));
				hidden.dispatchEvent(new Event('change', { bubbles: true }));
				
				const select = document.getElementById(fragmentID + '-options');
				window.renderTags(fragmentID, values, select);
			};
		}
		if (typeof window.renderTags === 'undefined') {
			window.renderTags = function(fragmentID, values, select) {
				const tagsDiv = document.getElementById(fragmentID + '-tags');
				if (!tagsDiv) return;
				tagsDiv.innerHTML = '';
				const labelMap = {};
				if (select) {
					for (let i = 0; i < select.options.length; i++) {
						const opt = select.options[i];
						if (opt.value) {
							labelMap[opt.value] = opt.text;
						}
					}
				}
				values.forEach(val => {
					const label = labelMap[val] || val;
					const badge = document.createElement('div');
					badge.className = 'badge badge-primary gap-1 p-3';
					
					const labelSpan = document.createElement('span');
					labelSpan.textContent = label;
					badge.appendChild(labelSpan);
					
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.style.cursor = 'pointer';
					btn.setAttribute('aria-label', 'Remove');
					btn.onmouseenter = function() { btn.style.opacity = '0.7'; };
					btn.onmouseleave = function() { btn.style.opacity = ''; };
					btn.onclick = function() { window.deselectTag(fragmentID, val); };
					btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18L18 6M6 6l12 12"></path></svg>';
					
					badge.appendChild(btn);
					tagsDiv.appendChild(badge);
				});
			};
		}
	</script>
}

// UsersTextInputFragment renders a plain text input inside users-fieldName-fragment.
// Used as fallback.
templ UsersTextInputFragment(fieldName, labelText, placeholder, helpText string) {
	<div id={ "users-" + fieldName + "-fragment" }>
		<div class="form-control">
			<label class="label" for={ "frag_" + fieldName }>
				<span class="label-text font-medium">{ labelText }</span>
			</label>
			<input
				id={ "frag_" + fieldName }
				type="text"
				name={ fieldName }
				placeholder={ placeholder }
				class="input input-bordered w-full"
				autocomplete="off"
			/>
			if helpText != "" {
				<label class="label">
					<span class="label-text-alt">{ helpText }</span>
				</label>
			}
		</div>
	</div>
}

// TeamSelectFragment renders the team picker dropped into #team-id-fragment
// by an SSE response when the profile select changes.
templ TeamSelectFragment(teams []model.Team, required bool) {
	<div id="team-id-fragment">
		<div class="form-control">
			<label class="label" for="frag_team_id">
				<span class="label-text font-medium">Filter by Team (optional)</span>
			</label>
			<select id="frag_team_id" name="team_id" class="select select-bordered w-full" if required { required }>
				<option value="">— select a team —</option>
				for _, t := range teams {
					<option value={ t.ID }>{ t.Name } ({ t.ID })</option>
				}
			</select>
		</div>
	</div>
}

// TeamInputFragment renders a plain text input inside #team-id-fragment.
// Used as initial state and as fallback when the API is unavailable.
// errMsg, when non-empty, shows a warning beside the field.
templ TeamInputFragment(required bool, errMsg string) {
	<div id="team-id-fragment">
		<div class="form-control">
			<label class="label" for="frag_team_id">
				<span class="label-text font-medium">Filter by Team ID (optional)</span>
			</label>
			<input
				id="frag_team_id"
				type="text"
				name="team_id"
				placeholder="42"
				class="input input-bordered w-full"
				if required { required }
				autocomplete="off"
			/>
			if errMsg != "" {
				<label class="label">
					<span class="label-text-alt text-warning">{ errMsg } Enter the team ID manually.</span>
				</label>
			}
		</div>
	</div>
}
