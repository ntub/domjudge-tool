package templates

templ Confirmation(id, title, confirmLabel string) {
	<div id={ id } class="modal" role="dialog" aria-modal="true" aria-labelledby={ id + "-title" }>
		<div class="modal-box">
			<h3 id={ id + "-title" } class="font-bold text-lg text-error">{ title }</h3>
			<div class="py-4 text-sm text-base-content/80">{ children... }</div>
			<div class="modal-action">
				<button type="button" class="btn btn-ghost" data-dj-cancel>Cancel</button>
				<button type="button" class="btn btn-error" data-dj-confirm>{ confirmLabel }</button>
			</div>
		</div>
		<div class="modal-backdrop bg-black/50" data-dj-cancel></div>
	</div>
}
