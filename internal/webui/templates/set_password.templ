package templates

import (
	"fmt"

	"github.com/ntub/domjudge-tool/internal/webui/profile"
)

templ SetPasswordForm(profiles []profile.ServerProfile, flash, flashKind string) {
	@Layout("Set Password") {
		<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
			<h1 class="text-2xl font-bold">Set Password</h1>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form
					method="post"
					action="/set-password"
					class="space-y-4"
					data-signals='{"profileId": ""}'
					data-dj-busy
				>
					<div class="form-control">
						<label class="label" for="sp_profile_id">
							<span class="label-text font-medium">Server Profile</span>
						</label>
						<select
							id="sp_profile_id"
							name="profile_id"
							class="select select-bordered w-full"
							data-bind:profile-id
							data-on:change="@get('/api/fragment/users')"
							required
						>
							<option value="">— choose a server —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ p.Host })</option>
							}
						</select>
					</div>
					@UsernameInputFragment("e.g. user1", "Select a server profile to load users, or enter the username directly.", "", true)
					<div class="form-control">
						<label class="label" for="sp_password">
							<span class="label-text font-medium">New Password</span>
						</label>
						<input
							id="sp_password"
							type="text"
							name="password"
							placeholder="Leave blank to generate automatically"
							class="input input-bordered w-full font-mono"
							autocomplete="new-password"
						/>
						<label class="label">
							<span class="label-text-alt">Leave blank to auto-generate a secure password.</span>
						</label>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Set Password</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ SetPasswordDone(username, password string, generated bool) {
	@Layout("Set Password — Done") {
		<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
			<h1 class="text-2xl font-bold">Set Password</h1>
			<a href="/set-password" class="btn btn-ghost btn-sm">← Set Another</a>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body space-y-4">
				<div class="alert alert-success">
					<span>Password updated successfully for <strong>{ username }</strong>.</span>
				</div>
				<div class="form-control">
					<label class="label">
						<span class="label-text font-medium">
							if generated {
								Generated Password
							} else {
								Password Set
							}
						</span>
					</label>
					<div class="flex items-center gap-2">
						<input
							type="text"
							value={ password }
							class="input input-bordered w-full font-mono"
							readonly
						/>
					</div>
					if generated {
						<label class="label">
							<span class="label-text-alt text-warning">Copy this password — it will not be shown again.</span>
						</label>
					}
				</div>
			</div>
		</div>
	}
}
