package templates

import (
	"fmt"
	"github.com/ntub/domjudge-tool/internal/webui/profile"
)

templ ImportProblemsForm(profiles []profile.ServerProfile, flash, flashKind string) {
	@Layout("Import Problems") {
		<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
			<h1 class="text-2xl font-bold">Import Problems</h1>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form
					method="post"
					action="/import-problems"
					enctype="multipart/form-data"
					class="space-y-4"
					data-signals='{"profileId": ""}'
					data-dj-busy
				>
					<div class="form-control">
						<label class="label" for="ip_profile_id">
							<span class="label-text font-medium">Server Profile</span>
						</label>
						<select
							id="ip_profile_id"
							name="profile_id"
							class="select select-bordered w-full"
							data-bind:profile-id
							data-on:change="@get('/api/fragment/contests')"
							required
						>
							<option value="">— choose a server —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ p.Host })</option>
							}
						</select>
					</div>
					@ContestInputFragment(
						"Leave blank to use profile's contest ID",
						"Select a server profile to load contests, or enter the ID directly.",
						"",
						false,
					)
					<div class="form-control">
						<label class="label" for="ip_zip_files">
							<span class="label-text font-medium">Problem ZIP Files</span>
						</label>
						<input
							id="ip_zip_files"
							type="file"
							name="zip_files"
							accept=".zip"
							multiple
							class="file-input file-input-bordered w-full"
							required
						/>
						<label class="label">
							<span class="label-text-alt">Select one or more problem package ZIP files to upload.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" name="upsert" class="checkbox"/>
							<span class="label-text">Upsert — update matching problems, create missing ones</span>
						</label>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Import</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ ImportProblemsRun(id int64) {
	@Layout("Import Problems — Running") {
		<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
			<h1 class="text-2xl font-bold">Import Problems</h1>
			<a href="/import-problems" class="btn btn-ghost btn-sm">← New Import</a>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body space-y-4"
				data-init={ fmt.Sprintf("@get('/import-problems/%d/stream')", id) }>
				<progress id="import-progress" class="progress progress-primary w-full" value="0" max="100"></progress>
				<span id="import-count" class="text-sm text-base-content/70" aria-live="polite">Starting…</span>
				<div id="import-result" role="status"></div>
			</div>
		</div>
	}
}
