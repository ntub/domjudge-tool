package templates

import (
	"fmt"
	"github.com/ntub/domjudge-tool/internal/desktop/profile"
)

templ ImportUsersForm(profiles []profile.ServerProfile, flash, flashKind string) {
	@Layout("Import Users & Teams") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Import Users &amp; Teams</h1>
		</div>
		@Flash(flashKind, flash)
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/import-users-teams" enctype="multipart/form-data" class="space-y-4">
					<div class="form-control">
						<label class="label" for="profile_id">
							<span class="label-text font-medium">Server Profile</span>
						</label>
						<select id="profile_id" name="profile_id" class="select select-bordered w-full" required>
							<option value="">— choose a server —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ p.Host })</option>
							}
						</select>
					</div>
					<div class="form-control">
						<label class="label" for="csv_file">
							<span class="label-text font-medium">CSV File</span>
						</label>
						<input id="csv_file" type="file" name="csv_file" accept=".csv,text/csv"
							class="file-input file-input-bordered w-full" required/>
						<label class="label">
							<span class="label-text-alt">Format: username, name, team, email, ...</span>
						</label>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Start Import</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ ImportUsersRun(oplogID int64) {
	@Layout("Importing…") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Import Progress</h1>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body space-y-4"
				data-on-load={ fmt.Sprintf("@get('/import-users-teams/%d/stream')", oplogID) }>
				<div class="flex items-center justify-between">
					<span class="font-medium">Progress</span>
					<span id="import-count" class="text-sm text-base-content/60">starting…</span>
				</div>
				<progress id="import-progress" class="progress progress-primary w-full" value="0" max="100"></progress>
				<div id="import-result"></div>
			</div>
		</div>
		<div class="mt-4">
			<a href="/import-users-teams" class="btn btn-ghost btn-sm">← Back</a>
		</div>
	}
}
