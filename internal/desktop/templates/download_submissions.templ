package templates

import (
	"fmt"
	"github.com/ntub/domjudge-tool/internal/desktop/profile"
)

templ DownloadSubmissionsForm(profiles []profile.ServerProfile, defaultOutDir, flash, flashKind string) {
	@Layout("Download Submissions") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Download Submissions</h1>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/download-submissions" class="space-y-4">
					<div class="form-control">
						<label class="label" for="ds_profile_id">
							<span class="label-text font-medium">Server Profile</span>
						</label>
						<select id="ds_profile_id" name="profile_id" class="select select-bordered w-full" required>
							<option value="">— choose a server —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ p.Host })</option>
							}
						</select>
					</div>
					<div class="form-control">
						<label class="label" for="ds_contest_id">
							<span class="label-text font-medium">Contest ID</span>
						</label>
						<input
							id="ds_contest_id"
							type="text"
							name="contest_id"
							placeholder="e.g. 1"
							class="input input-bordered w-full"
							required
						/>
					</div>
					<div class="form-control">
						<label class="label" for="ds_out_dir">
							<span class="label-text font-medium">Output Directory</span>
						</label>
						<input
							id="ds_out_dir"
							type="text"
							name="out_dir"
							value={ defaultOutDir }
							placeholder="/path/to/submissions"
							class="input input-bordered w-full"
							required
						/>
						<label class="label">
							<span class="label-text-alt">Absolute path where submission ZIPs will be saved.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label" for="ds_problem_ids">
							<span class="label-text font-medium">Problem IDs (optional)</span>
						</label>
						<input
							id="ds_problem_ids"
							type="text"
							name="problem_ids"
							placeholder="P1, P2 …"
							class="input input-bordered w-full"
						/>
						<label class="label">
							<span class="label-text-alt">Comma-separated problem IDs to filter. Leave blank to download all.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label" for="ds_mode">
							<span class="label-text font-medium">Folder Layout</span>
						</label>
						<select id="ds_mode" name="mode" class="select select-bordered w-full">
							<option value="2" selected>Problem-first (problem_X/team_Y)</option>
							<option value="1">Team-first (team_Y/problem_X)</option>
							<option value="0">Contest folder (contest_ID)</option>
						</select>
					</div>
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" name="extract" id="ds_extract" class="checkbox" checked/>
							<span class="label-text">Extract source files (unzip in place)</span>
						</label>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Download</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ DownloadSubmissionsRun(id int64) {
	@Layout("Download Submissions — Running") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Download Submissions</h1>
			<a href="/download-submissions" class="btn btn-ghost btn-sm">← New Download</a>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body space-y-4"
				data-on-load={ fmt.Sprintf("@get('/download-submissions/%d/stream')", id) }>
				<progress id="import-progress" class="progress progress-primary w-full" value="0" max="100"></progress>
				<span id="import-count" class="text-sm text-base-content/70">Starting…</span>
				<div id="import-result"></div>
			</div>
		</div>
	}
}
