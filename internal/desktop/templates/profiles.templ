package templates

import (
	"fmt"
	"github.com/ntub/domjudge-tool/internal/desktop/profile"
)

templ ProfileList(profiles []profile.ServerProfile, flash, flashKind string) {
	@Layout("Server Profiles") {
		@Flash(flashKind, flash)
		<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
			<h1 class="text-2xl font-bold">Server Profiles</h1>
			<a href="/profiles/new" class="btn btn-primary btn-sm">+ Add Server</a>
		</div>
		if len(profiles) == 0 {
			<div class="card bg-base-100 shadow p-8 text-center">
				<p class="text-base-content/60 mb-4">No servers configured yet.</p>
				<a href="/profiles/new" class="btn btn-primary btn-sm mx-auto">Add your first server</a>
			</div>
		} else {
			<div class="card bg-base-100 shadow overflow-x-auto">
				<table class="table table-zebra dj-profile-table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Host</th>
							<th>Version</th>
							<th>Default</th>
							<th><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range profiles {
							<tr>
								<td class="font-medium">
									{ p.Name }
									if p.IsDefault {
										<span class="badge badge-success badge-xs ml-2">default</span>
									}
								</td>
								<td class="text-sm font-mono max-w-[18rem] truncate dj-host-cell" title={ p.Host }>{ p.Host }</td>
								<td><span class="badge badge-ghost badge-sm">{ p.Version }</span></td>
								<td>
									if !p.IsDefault {
										<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/profiles/%d/default", p.ID)) }>
											<button class="btn btn-ghost btn-xs">Set default</button>
										</form>
									}
								</td>
								<td class="whitespace-nowrap">
									<div class="flex gap-2 justify-end">
										<a href={ templ.SafeURL(fmt.Sprintf("/profiles/%d/edit", p.ID)) } class="btn btn-ghost btn-xs">Edit</a>
										<button
											type="button"
											class="btn btn-error btn-xs delete-profile-btn"
											data-profile-id={ fmt.Sprintf("%d", p.ID) }
											data-profile-name={ p.Name }
										>
											Delete
										</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@Confirmation("delete-profile-modal", "Delete Server Profile", "Delete Profile") {
			<p>Are you sure you want to delete profile <strong id="delete-profile-name"></strong>? This cannot be undone.</p>
		}
		<form id="delete-profile-form" method="POST" class="hidden" data-dj-busy></form>
		<script>
			(function(){
				var modal = document.getElementById('delete-profile-modal');
				var form = document.getElementById('delete-profile-form');
				document.addEventListener('click', function(e){
					var btn = e.target.closest('.delete-profile-btn');
					if (!btn) return;
					document.getElementById('delete-profile-name').textContent = btn.getAttribute('data-profile-name');
					form.action = '/profiles/' + btn.getAttribute('data-profile-id') + '/delete';
					window.djConfirm(modal, function(){ form.requestSubmit(); });
				});
			})();
		</script>
	}
}

templ ProfileForm(p profile.ServerProfile, action, submitLabel, flash, flashKind string) {
	@Layout(submitLabel + " Server") {
		@Flash(flashKind, flash)
		<div class="max-w-2xl">
			<h1 class="text-2xl font-bold mb-6">{ submitLabel } Server</h1>
			<form method="POST" action={ templ.SafeURL(action) } class="card bg-base-100 shadow p-6 flex flex-col gap-4" data-dj-busy>
				<label class="form-control">
					<div class="label"><span class="label-text">Profile name *</span></div>
					<input type="text" name="name" required class="input input-bordered"
					       placeholder="prod" value={ p.Name }/>
				</label>
				<label class="form-control">
					<div class="label"><span class="label-text">Host URL *</span></div>
					<input type="url" name="host" required class="input input-bordered"
					       placeholder="https://domjudge.example.org" value={ p.Host }/>
				</label>
				<label class="form-control">
					<div class="label"><span class="label-text">Username *</span></div>
					<input type="text" name="username" required class="input input-bordered"
					       placeholder="admin" value={ p.Username }/>
				</label>
				<label class="form-control">
					<div class="label"><span class="label-text">Password *</span></div>
					<input type="password" name="password" required class="input input-bordered"
					       placeholder="••••••••" value={ p.Password }/>
				</label>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<label class="form-control">
						<div class="label"><span class="label-text">DOMjudge version</span></div>
						<input type="text" name="version" class="input input-bordered"
						       placeholder="7.3.2" value={ p.Version }/>
					</label>
					<label class="form-control">
						<div class="label"><span class="label-text">Contest ID (optional)</span></div>
						<input type="text" name="contest_id" class="input input-bordered"
						       placeholder="1" value={ stringVal(p.ContestID) }/>
					</label>
				</div>
				<div class="form-control">
					<label class="label cursor-pointer gap-3 justify-start">
						<input type="checkbox" name="disable_ssl" class="checkbox checkbox-sm"
						       if p.DisableSSL { checked }/>
						<span class="label-text">Disable SSL verification (not recommended)</span>
					</label>
				</div>
				<div class="flex gap-3 justify-end mt-2">
					<a href="/profiles" class="btn btn-ghost">Cancel</a>
					<button type="submit" class="btn btn-primary">{ submitLabel }</button>
				</div>
			</form>
		</div>
	}
}

func stringVal(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}
