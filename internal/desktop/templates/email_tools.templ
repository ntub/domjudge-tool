package templates

import "fmt"

templ EmailToolsIndex(flash, flashKind string) {
	@Layout("Email Tools") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Email Tools</h1>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			<a href="/email-tools/scaffold" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
				<div class="card-body">
					<h2 class="card-title">Scaffold Template</h2>
					<p class="text-base-content/70 text-sm">Write a starter <code>subject.txt</code> / <code>body.html</code> / <code>body.txt</code> into a directory.</p>
				</div>
			</a>
			<a href="/email-tools/validate" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
				<div class="card-body">
					<h2 class="card-title">Validate Template</h2>
					<p class="text-base-content/70 text-sm">Check that a template directory has valid subject and body files.</p>
				</div>
			</a>
			<a href="/email-tools/render" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
				<div class="card-body">
					<h2 class="card-title">Render Emails</h2>
					<p class="text-base-content/70 text-sm">Render per-user <code>.eml</code> files from a CSV without sending.</p>
				</div>
			</a>
			<a href="/email-tools/send" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
				<div class="card-body">
					<h2 class="card-title">Send Emails</h2>
					<p class="text-base-content/70 text-sm">Send credential emails via SMTP. Uses settings from the Settings page.</p>
				</div>
			</a>
		</div>
	}
}

templ EmailScaffoldForm(flash, flashKind string) {
	@Layout("Email Tools — Scaffold") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Scaffold Template</h1>
			<a href="/email-tools" class="btn btn-ghost btn-sm">← Email Tools</a>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/email-tools/scaffold" class="space-y-4">
					<div class="form-control">
						<label class="label" for="es_dir">
							<span class="label-text font-medium">Template Directory</span>
						</label>
						<input
							id="es_dir"
							type="text"
							name="template_dir"
							placeholder="/path/to/email-template"
							class="input input-bordered w-full"
							required
						/>
						<label class="label">
							<span class="label-text-alt">Directory will be created if it does not exist.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" name="force" id="es_force" class="checkbox"/>
							<span class="label-text">Overwrite existing files</span>
						</label>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Write Scaffold</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ EmailValidateForm(flash, flashKind string) {
	@Layout("Email Tools — Validate") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Validate Template</h1>
			<a href="/email-tools" class="btn btn-ghost btn-sm">← Email Tools</a>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/email-tools/validate" class="space-y-4">
					<div class="form-control">
						<label class="label" for="ev_dir">
							<span class="label-text font-medium">Template Directory</span>
						</label>
						<input
							id="ev_dir"
							type="text"
							name="template_dir"
							placeholder="/path/to/email-template"
							class="input input-bordered w-full"
							required
						/>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Validate</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ EmailRenderForm(flash, flashKind string) {
	@Layout("Email Tools — Render") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Render Emails</h1>
			<a href="/email-tools" class="btn btn-ghost btn-sm">← Email Tools</a>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/email-tools/render" class="space-y-4">
					<div class="form-control">
						<label class="label" for="er_csv">
							<span class="label-text font-medium">CSV File</span>
						</label>
						<input
							id="er_csv"
							type="text"
							name="csv_path"
							placeholder="/path/to/import-users-teams-out.csv"
							class="input input-bordered w-full"
							required
						/>
						<label class="label">
							<span class="label-text-alt">Output CSV from Import Users (contains generated passwords).</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label" for="er_tmpl">
							<span class="label-text font-medium">Template Directory</span>
						</label>
						<input
							id="er_tmpl"
							type="text"
							name="template_dir"
							placeholder="/path/to/email-template"
							class="input input-bordered w-full"
							required
						/>
					</div>
					<div class="form-control">
						<label class="label" for="er_out">
							<span class="label-text font-medium">Output Directory</span>
						</label>
						<input
							id="er_out"
							type="text"
							name="output_dir"
							placeholder="/path/to/rendered-emails"
							class="input input-bordered w-full"
							required
						/>
					</div>
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" name="force" id="er_force" class="checkbox"/>
							<span class="label-text">Overwrite existing .eml files</span>
						</label>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Render</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ EmailSendForm(flash, flashKind string) {
	@Layout("Email Tools — Send") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Send Emails</h1>
			<a href="/email-tools" class="btn btn-ghost btn-sm">← Email Tools</a>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="alert alert-info mb-4">
			<span>SMTP settings are loaded from the <a href="/settings" class="link">Settings</a> page.</span>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/email-tools/send" class="space-y-4">
					<div class="form-control">
						<label class="label" for="esnd_csv">
							<span class="label-text font-medium">CSV File</span>
						</label>
						<input
							id="esnd_csv"
							type="text"
							name="csv_path"
							placeholder="/path/to/import-users-teams-out.csv"
							class="input input-bordered w-full"
							required
						/>
						<label class="label">
							<span class="label-text-alt">Output CSV from Import Users (contains generated passwords).</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label" for="esnd_tmpl">
							<span class="label-text font-medium">Template Directory</span>
						</label>
						<input
							id="esnd_tmpl"
							type="text"
							name="template_dir"
							placeholder="/path/to/email-template"
							class="input input-bordered w-full"
							required
						/>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Send</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ EmailSendRun(id int64) {
	@Layout("Email Tools — Sending") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Send Emails</h1>
			<a href="/email-tools/send" class="btn btn-ghost btn-sm">← New Send</a>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body space-y-4"
				data-on-load={ fmt.Sprintf("@get('/email-tools/send/%d/stream')", id) }>
				<progress id="import-progress" class="progress progress-primary w-full" value="0" max="100"></progress>
				<span id="import-count" class="text-sm text-base-content/70">Starting…</span>
				<div id="import-result"></div>
			</div>
		</div>
	}
}
