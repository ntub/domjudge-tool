package templates

import (
	"fmt"
	"github.com/ntub/domjudge-tool/internal/desktop/profile"
)

templ ExportUsersForm(profiles []profile.ServerProfile) {
	@Layout("Export Users") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Export Users</h1>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/export-users" class="space-y-4">
					<div class="form-control">
						<label class="label" for="export_profile_id">
							<span class="label-text font-medium">Server Profile</span>
						</label>
						<select id="export_profile_id" name="profile_id" class="select select-bordered w-full" required>
							<option value="">— choose a server —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ p.Host })</option>
							}
						</select>
					</div>
					<div class="form-control">
						<label class="label" for="format">
							<span class="label-text font-medium">Format</span>
						</label>
						<select id="format" name="format" class="select select-bordered w-full">
							<option value="csv">CSV</option>
							<option value="json">JSON</option>
						</select>
					</div>
					<div class="form-control">
						<label class="label" for="ids">
							<span class="label-text font-medium">Filter by User IDs (optional)</span>
						</label>
						<input id="ids" type="text" name="ids"
							placeholder="1, 2, 3 …"
							class="input input-bordered w-full"/>
						<label class="label">
							<span class="label-text-alt">Comma-separated user IDs. Leave blank to export all.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label" for="team_id">
							<span class="label-text font-medium">Filter by Team ID (optional)</span>
						</label>
						<input id="team_id" type="text" name="team_id"
							placeholder="42"
							class="input input-bordered w-full"/>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Download</button>
					</div>
				</form>
			</div>
		</div>
	}
}
