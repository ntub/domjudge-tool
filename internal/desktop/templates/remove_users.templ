package templates

import (
	"fmt"
	"github.com/ntub/domjudge-tool/internal/desktop/profile"
)

templ RemoveUsersForm(profiles []profile.ServerProfile, flash, flashKind string) {
	@Layout("Remove Users & Teams") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Remove Users &amp; Teams</h1>
		</div>
		@Flash(flashKind, flash)
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/remove-users-teams" class="space-y-4">
					<div class="form-control">
						<label class="label" for="remove_profile_id">
							<span class="label-text font-medium">Server Profile</span>
						</label>
						<select id="remove_profile_id" name="profile_id" class="select select-bordered w-full" required>
							<option value="">— choose a server —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ p.Host })</option>
							}
						</select>
					</div>
					<div class="form-control">
						<label class="label" for="include">
							<span class="label-text font-medium">Include (usernames to delete)</span>
						</label>
						<input id="include" type="text" name="include"
							placeholder="user1, user2, … (blank = all non-protected)"
							class="input input-bordered w-full"/>
						<label class="label">
							<span class="label-text-alt">Comma-separated. Leave blank to delete all non-protected users.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label" for="exclude">
							<span class="label-text font-medium">Exclude (usernames to keep)</span>
						</label>
						<input id="exclude" type="text" name="exclude"
							placeholder="user3, user4, …"
							class="input input-bordered w-full"/>
						<label class="label">
							<span class="label-text-alt">Protected users (admin, judgehost, server account) are always excluded.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" name="dry_run" id="dry_run" class="checkbox checkbox-warning"/>
							<span class="label-text font-medium">Dry-run (preview only, no changes)</span>
						</label>
					</div>
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-error">Remove Users &amp; Teams</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ RemoveUsersRun(oplogID int64) {
	@Layout("Removing…") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Remove Progress</h1>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body space-y-4"
				data-on-load={ fmt.Sprintf("@get('/remove-users-teams/%d/stream')", oplogID) }>
				<div class="flex items-center justify-between">
					<span class="font-medium">Progress</span>
					<span id="remove-count" class="text-sm text-base-content/60">starting…</span>
				</div>
				<progress id="remove-progress" class="progress progress-error w-full" value="0" max="100"></progress>
				<div id="remove-result"></div>
			</div>
		</div>
		<div class="mt-4">
			<a href="/remove-users-teams" class="btn btn-ghost btn-sm">← Back</a>
		</div>
	}
}
