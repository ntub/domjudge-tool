package templates

import (
	"fmt"
	"github.com/ntub/domjudge-tool/internal/desktop/profile"
)

templ DownloadProblemsForm(profiles []profile.ServerProfile, defaultOutDir, flash, flashKind string) {
	@Layout("Download Problems") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Download Problems</h1>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<form method="post" action="/download-problems" class="space-y-4" data-signals={ fmt.Sprintf(`{"profileId": "", "outDir": %q}`, defaultOutDir) }>
					<div class="form-control">
						<label class="label" for="dp_profile_id">
							<span class="label-text font-medium">Server Profile</span>
						</label>
						<select
							id="dp_profile_id"
							name="profile_id"
							class="select select-bordered w-full"
							data-bind:profile-id
							data-on:change="@get('/api/fragment/problems?field=only,exclude')"
							required
						>
							<option value="">— choose a server —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) }>{ p.Name } ({ p.Host })</option>
							}
						</select>
					</div>
					<div class="form-control">
						<label class="label" for="out_dir">
							<span class="label-text font-medium">Output Directory</span>
						</label>
						<div class="flex gap-2">
							<input
								id="out_dir"
								type="text"
								name="out_dir"
								data-bind:out-dir
								placeholder="/path/to/export_problems"
								class="input input-bordered grow"
								required
							/>
							<button
								type="button"
								class="btn btn-neutral"
								data-on:click="@get('/api/pick-directory?signal=outDir')"
							>
								Browse…
							</button>
						</div>
						<label class="label">
							<span class="label-text-alt">Absolute path where ZIPs will be saved.</span>
						</label>
					</div>
					@ProblemsTextInputFragment("only", "Only Problem IDs (optional)", "A, B, C …", "Comma-separated problem IDs to include. Leave blank to download all (uses profile contest ID if set).")
					@ProblemsTextInputFragment("exclude", "Exclude Problem IDs (optional)", "X, Y …", "")
					<div class="card-actions justify-end pt-2">
						<button type="submit" class="btn btn-primary">Download</button>
					</div>
				</form>
			</div>
		</div>
	}
}

templ DownloadProblemsRun(id int64) {
	@Layout("Download Problems — Running") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Download Problems</h1>
			<a href="/download-problems" class="btn btn-ghost btn-sm">← New Download</a>
		</div>
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body space-y-4"
				data-init={ fmt.Sprintf("@get('/download-problems/%d/stream')", id) }>
				<progress id="import-progress" class="progress progress-primary w-full" value="0" max="100"></progress>
				<span id="import-count" class="text-sm text-base-content/70">Starting…</span>
				<div id="import-result"></div>
			</div>
		</div>
	}
}
