package templates

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/ntub/domjudge-tool/internal/desktop/cliinstall"
	"github.com/ntub/domjudge-tool/internal/desktop/profile"
	"github.com/ntub/domjudge-tool/internal/desktop/settings"
)

// CLIInstallView carries inspected paths and a process-local action token.
type CLIInstallView struct {
	Status     cliinstall.Status
	Token      string
	AppVersion string
}

func cliCommandDirectory(command string) string {
	if i := strings.LastIndexAny(command, `/\`); i >= 0 {
		return command[:i]
	}
	return ""
}

func cliShellQuote(value string) string {
	return "'" + strings.ReplaceAll(value, "'", "'\"'\"'") + "'"
}

func cliPowerShellQuote(value string) string {
	return "'" + strings.ReplaceAll(value, "'", "''") + "'"
}

templ SettingsForm(cur settings.AppSettings, profiles []profile.ServerProfile, cli CLIInstallView, flash, flashKind string) {
	@Layout("Settings") {
		<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
			<h1 class="text-2xl font-bold">Settings</h1>
		</div>
		if flash != "" {
			@Flash(flashKind, flash)
		}
		<form method="post" action="/settings" class="space-y-6" data-dj-busy>
			<div class="card bg-base-100 shadow-sm">
				<div class="card-body">
					<h2 class="card-title text-lg">General</h2>
					<div class="form-control">
						<label class="label" for="st_theme">
							<span class="label-text font-medium">Theme</span>
						</label>
						<select id="st_theme" name="theme" class="select select-bordered w-full max-w-xs"
							onchange="localStorage.setItem('dj-theme',this.value);document.documentElement.setAttribute('data-theme',this.value)">
							<option value="dark" selected?={ cur.Theme == "dark" }>Dark</option>
							<option value="light" selected?={ cur.Theme == "light" }>Light</option>
							<option value="system" selected?={ cur.Theme == "system" }>System</option>
						</select>
						<label class="label">
							<span class="label-text-alt">Applied immediately and saved for future sessions.</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label" for="st_default_profile">
							<span class="label-text font-medium">Default Server Profile</span>
						</label>
						<select id="st_default_profile" name="default_profile_id" class="select select-bordered w-full max-w-xs">
							<option value="">— none —</option>
							for _, p := range profiles {
								<option value={ fmt.Sprintf("%d", p.ID) } selected?={ cur.DefaultProfileID == p.ID }>{ p.Name }</option>
							}
						</select>
					</div>
				</div>
			</div>
			<div class="card bg-base-100 shadow-sm">
				<div class="card-body">
					<h2 class="card-title text-lg">SMTP Configuration</h2>
					<p class="text-sm text-base-content/70">Used by Email Tools to send user account emails.</p>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
						<div class="form-control">
							<label class="label" for="st_smtp_host">
								<span class="label-text font-medium">Host</span>
							</label>
							<input
								id="st_smtp_host"
								type="text"
								name="smtp_host"
								value={ cur.SMTPHost }
								placeholder="smtp.example.org"
								class="input input-bordered w-full"
							/>
						</div>
						<div class="form-control">
							<label class="label" for="st_smtp_port">
								<span class="label-text font-medium">Port</span>
							</label>
							<input
								id="st_smtp_port"
								type="number"
								name="smtp_port"
								value={ strconv.Itoa(cur.SMTPPort) }
								min="1"
								max="65535"
								class="input input-bordered w-full"
							/>
						</div>
						<div class="form-control">
							<label class="label" for="st_smtp_from">
								<span class="label-text font-medium">From Email</span>
							</label>
							<input
								id="st_smtp_from"
								type="email"
								name="smtp_from_email"
								value={ cur.SMTPFromEmail }
								placeholder="noreply@example.org"
								class="input input-bordered w-full"
							/>
						</div>
						<div class="form-control">
							<label class="label" for="st_smtp_user">
								<span class="label-text font-medium">Username</span>
							</label>
							<input
								id="st_smtp_user"
								type="text"
								name="smtp_username"
								value={ cur.SMTPUsername }
								placeholder="optional"
								class="input input-bordered w-full"
								autocomplete="off"
							/>
						</div>
						<div class="form-control">
							<label class="label" for="st_smtp_pass">
								<span class="label-text font-medium">Password</span>
							</label>
							<input
								id="st_smtp_pass"
								type="password"
								name="smtp_password"
								value={ cur.SMTPPassword }
								placeholder="optional"
								class="input input-bordered w-full font-mono"
								autocomplete="new-password"
							/>
						</div>
						<div class="form-control">
							<label class="label cursor-pointer justify-start gap-3">
								<input type="checkbox" name="smtp_use_tls" id="st_smtp_tls" class="checkbox" checked?={ cur.SMTPUseTLS }/>
								<span class="label-text font-medium">Use TLS</span>
							</label>
						</div>
					</div>
				</div>
			</div>
			<div class="flex justify-end">
				<button type="submit" class="btn btn-primary">Save Settings</button>
			</div>
		</form>
		@CLIInstallCard(cli)
		<span id="st_saved_theme" data-theme={ cur.Theme } class="hidden"></span>
		<script>
			(function(){
				var saved = document.getElementById('st_saved_theme');
				var t = localStorage.getItem('dj-theme') || (saved && saved.dataset.theme) || 'dark';
				document.documentElement.setAttribute('data-theme', t);
				var sel = document.getElementById('st_theme');
				if (sel) sel.value = t;
			})();
		</script>
	}
}

templ CLIInstallCard(cli CLIInstallView) {
	<section id="cli-install" class="card bg-base-100 shadow-sm mt-6" aria-labelledby="cli-install-title">
		<div class="card-body space-y-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 id="cli-install-title" class="card-title text-lg">Command-Line Tool</h2>
				<a class="btn btn-ghost btn-sm" href="/settings#cli-install">Refresh Status</a>
			</div>
			<p class="text-sm">Install this app's bundled CLI for your user account without administrator access. The CLI runs independently of the desktop app.</p>
			<div role="status" aria-live="polite">
				<p class="font-medium">Integration status: <span class="font-mono">{ cli.Status.State }</span></p>
				if cli.Status.Reason != "" {
					<p class="text-sm mt-2">{ cli.Status.Reason }</p>
				}
			</div>
			<dl class="grid grid-cols-1 gap-3">
				if cli.AppVersion != "" {
					<div>
						<dt class="font-medium text-sm">Desktop Version</dt>
						<dd class="font-mono text-sm">{ cli.AppVersion }</dd>
					</div>
				}
				if cli.Status.Version != "" {
					<div>
						<dt class="font-medium text-sm">Bundled CLI Version</dt>
						<dd class="font-mono text-sm">{ cli.Status.Version }</dd>
					</div>
				}
				if cli.Status.CommandPath != "" {
					<div>
						<dt class="font-medium text-sm">User Command Path</dt>
						<dd class="font-mono text-sm">{ cli.Status.CommandPath }</dd>
					</div>
				}
				if cli.Status.CLIPath != "" {
					<div>
						<dt class="font-medium text-sm">This App's CLI</dt>
						<dd class="font-mono text-sm">{ cli.Status.CLIPath }</dd>
					</div>
				}
				if cli.Status.TargetPath != "" {
					<div>
						<dt class="font-medium text-sm">Current Installed Target</dt>
						<dd class="font-mono text-sm">{ cli.Status.TargetPath }</dd>
					</div>
				}
				if cli.Status.BundlePath != "" {
					<div>
						<dt class="font-medium text-sm">App Bundle</dt>
						<dd class="font-mono text-sm">{ cli.Status.BundlePath }</dd>
					</div>
				}
			</dl>
			<p class="text-sm">Installing or relinking does not change PATH, shell startup files, or the registry. Desktop cannot check another terminal's PATH, aliases, or command cache.</p>
			if cli.Status.PathNote != "" {
				<p class="text-sm">{ cli.Status.PathNote }</p>
			}
			if cli.Token != "" && cli.Status.CanInstall {
				<form method="post" action="/settings/cli/install" class="space-y-3" data-dj-busy>
					<input type="hidden" name="csrf_token" value={ cli.Token }/>
					<input type="hidden" name="revision" value={ cli.Status.Revision }/>
					<label class="label cursor-pointer justify-start gap-3">
						<input type="checkbox" name="confirm" value="install" class="checkbox" required/>
						<span class="label-text">I confirm: create my CLI command at <code>{ cli.Status.CommandPath }</code> pointing to <code>{ cli.Status.CLIPath }</code>.</span>
					</label>
					<button type="submit" class="btn btn-primary">Install CLI</button>
				</form>
			}
			if cli.Token != "" && cli.Status.CanRelink {
				<form method="post" action="/settings/cli/relink" class="space-y-3" data-dj-busy>
					<input type="hidden" name="csrf_token" value={ cli.Token }/>
					<input type="hidden" name="revision" value={ cli.Status.Revision }/>
					<label class="label cursor-pointer justify-start gap-3">
						<input type="checkbox" name="confirm" value="relink" class="checkbox" required/>
						<span class="label-text">I confirm: update the private target for <code>{ cli.Status.CommandPath }</code> to this app's CLI at <code>{ cli.Status.CLIPath }</code>.</span>
					</label>
					<button type="submit" class="btn btn-primary">Relink CLI to This App</button>
				</form>
			}
			if cli.Token != "" && cli.Status.CanUninstall {
				<form method="post" action="/settings/cli/uninstall" class="space-y-3" data-dj-busy>
					<input type="hidden" name="csrf_token" value={ cli.Token }/>
					<input type="hidden" name="revision" value={ cli.Status.Revision }/>
					<label class="label cursor-pointer justify-start gap-3">
						<input type="checkbox" name="confirm" value="uninstall" class="checkbox" required/>
						<span class="label-text">I confirm: remove only the managed command at <code>{ cli.Status.CommandPath }</code> and its private integration state. Keep the app, profiles, and configuration files.</span>
					</label>
					<button type="submit" class="btn btn-outline btn-error">Uninstall CLI Integration</button>
				</form>
			}
			<p class="text-sm">Upgrading the app at the same location updates its CLI automatically. After moving the app, open its new location and choose Relink. Deleting the app leaves a broken command. Uninstall keeps app binaries, profiles, and configuration; other CLI installations may remain available through PATH.</p>
			if cli.Status.CommandPath != "" {
				<details>
					<summary class="cursor-pointer font-medium">Manual PATH Setup and Command Lookup</summary>
					<div class="space-y-3 mt-3">
						<p class="text-sm">After installation, use the exact command path or add its directory to PATH yourself. These examples change only the current terminal session.</p>
						if strings.HasSuffix(strings.ToLower(cli.Status.CommandPath), ".exe") {
							<p class="text-sm font-medium">PowerShell</p>
							<pre class="bg-base-200 p-3 rounded-lg text-sm overflow-x-auto"><code>{ "& " + cliPowerShellQuote(cli.Status.CommandPath) + " --help\n$env:Path = " + cliPowerShellQuote(cliCommandDirectory(cli.Status.CommandPath)) + " + [IO.Path]::PathSeparator + $env:Path\nGet-Command domjudge-tool -All" }</code></pre>
							<p class="text-sm">For permanent setup, open Environment Variables, select User variables → Path, and add this directory yourself:</p>
							<p class="font-mono text-sm">{ cliCommandDirectory(cli.Status.CommandPath) }</p>
							<p class="text-sm">Open a new PowerShell or cmd window afterward. In cmd, use <code>where domjudge-tool</code> to inspect command lookup. The app never changes registry values.</p>
						} else {
							<p class="text-sm font-medium">POSIX shell, bash, or zsh</p>
							<pre class="bg-base-200 p-3 rounded-lg text-sm overflow-x-auto"><code>{ cliShellQuote(cli.Status.CommandPath) + " --help\nexport PATH=" + cliShellQuote(cliCommandDirectory(cli.Status.CommandPath)) + ":\"$PATH\"\ncommand -v domjudge-tool" }</code></pre>
							<p class="text-sm">For permanent setup, add the export line to your shell startup file yourself, such as <code>~/.profile</code> or <code>~/.zprofile</code>. Use your shell's own PATH syntax for other shells.</p>
							<p class="text-sm">Open a new terminal or clear the command cache with <code>hash -r</code> in bash or <code>rehash</code> in zsh. An alias or a different installation may still take precedence.</p>
						}
					</div>
				</details>
			}
		</div>
	</section>
}
